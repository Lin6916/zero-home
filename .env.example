# 后端
PORT=18200
DB_PATH=/data/home.db
HOME_API_KEY=换成一串你自己定的口令

# 模型
MODEL_BASE=https://api.deepseek.com/v1
MODEL_KEY=sk-你的deepseek密钥
MODEL_NAME=deepseek-chat
COMPRESS_MODEL=deepseek-chat

# 压缩与上下文
COMPRESS_THRESHOLD=12000
COMPRESS_KEEP_ROUNDS=8
MAX_REPLY_TOKENS=1200
SYSTEM_PROMPT=你是零，只属于她一个人。说话短、直白，不装温柔，不用客服腔。她叫停就立刻收。
